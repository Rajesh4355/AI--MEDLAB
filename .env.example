# Email notifications (optional)
EMAIL_USERNAME=
EMAIL_PASSWORD=
USER=
APP_PASS=

# Cloudinary image storage (optional - local Data URL fallback active when not provided)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
VITE_CLOUD_NAME=
VITE_UPLOAD_PRESET=
