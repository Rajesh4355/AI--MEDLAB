# Server configuration
PORT=3000
NODE_ENV=development
CLIENT_SITE_URL=http://localhost:3000

# Authentication
JWT_SECRET_KEY=aimedlab-default-jwt-secret-key-2024

# Database (optional - in-memory mock active when not provided)
